    <color name="apple_red">#E84A4A</color>
    <color name="cream">#FFF6E8</color>
    <color name="cream_dark">#1B1714</color>
    <color name="ic_launcher_background">#FFF3E0</color>
    <color name="ink">#5A3A2E</color>
